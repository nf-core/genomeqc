// The pipeline's `test` profile sets `cleanup = true` (conf/test.config), which races
// Nextflow's work-dir deletion against nf-test's snapshot serialization and can silently
// replace file content hashes with stale absolute paths. Disable it for this test.
cleanup = false

process {
    withName: 'HITE' {
        cpus   = 2
        memory = 6.GB
    }
    withName: 'REPEATMASKER_REPEATMASKER' {
        ext.args = '-no_is -gff' // Not required but significantly cuts the runtime
    }
}
