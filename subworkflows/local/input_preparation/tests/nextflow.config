// The pipeline's `test` profile sets `cleanup = true` (conf/test.config), which races
// Nextflow's work-dir deletion against nf-test's snapshot serialization and can silently
// replace file content hashes with stale absolute paths. Disable it for this test.
cleanup = false

process {
    // ncbi-genome-download writes an appdirs cache under $HOME/.cache; the container runs
    // as the host UID with no matching /etc/passwd entry, so HOME is unset/root-owned and
    // the write fails with EACCES. Point it at a writable scratch HOME for this test.
    // `-e` sets an env var under Docker, but under Singularity/Apptainer it's the boolean
    // `--cleanenv` flag - passing it a value there makes that value get parsed as the image
    // path instead, so the engine needs its own flag (`--home`) for the same effect.
    withName: 'NCBIGENOMEDOWNLOAD' {
        containerOptions = { workflow.containerEngine in ['singularity', 'apptainer'] ? '--home /tmp' : '-e HOME=/tmp' }
    }
}
