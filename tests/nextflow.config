/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/'
}

aws.client.anonymous = true // fixes S3 access issues on self-hosted runners

// conf/test.config sets cleanup = true to save disk on full pipeline test runs, but that
// deletes each task's work directory as soon as it succeeds - nf-test needs those directories
// to still exist afterwards to inspect/hash outputs, so force it back off here.
cleanup = false
