# Ideogram PNGs render byte-different between conda's and docker's graphics stacks even
# for identical content - the matching .svg (vector, checked separately) proves that.
busco/*/*/ideogram/*.png
# pngs for merqury are not deterministic
merqury/*/*.png
busco/busco_downloads/lineages/*/refseq_db.faa.gz
quast/**/quast.log
quast/**/report.html
quast/**/report.pdf
# debug_gene_mapping.txt's content isn't repeatable (order-dependent on GFF processing), so it's excluded rather than snapshotted.
ortho_seq_count/debug_gene_mapping.txt
**/*.pdf
agat/Mycoplasmoides_gallisepticum/stats/Mycoplasmoides_gallisepticum.stats.txt
**/tree.nw
**/tree_plot.*
**/*.xlsx
**/*.html
