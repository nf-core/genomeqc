nextflow_pipeline {

    name "Test decontamination profile"
    script "../main.nf"
    tag "test_decon"
    profile "test_decon"

    test("-profile test_decon") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
            def software_versions = removeNextflowVersion("$outputDir/pipeline_info/nf_core_genomeqc_software_mqc_versions.yml")
            // fcs_gx_report.txt's first line has a timestamp
            def fcs_gx_report_body = file("$outputDir/decontamination/fcs-gx/test_combo.fcs_gx_report.txt")
                .readLines()
                .drop(1)
                .join('\n')
            assert workflow.success
            assertAll(
                { assert snapshot(
                    software_versions,
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content,
                    fcs_gx_report_body
                ).match() }
            )
        }

        cleanup {
            // Only prune/delete on CI - keeping local VM state intact prevents
            // cross-test launchDir wipes that break nf-test snapshot walks.
            if (System.getenv("CI") == "true") {
                if (System.getenv("NFT_PROFILE")?.contains("docker")) {
                    "docker system prune -a -f --volumes".execute().waitFor()
                }
                new File("${launchDir}").deleteDir()
            }
        }
    }
}
