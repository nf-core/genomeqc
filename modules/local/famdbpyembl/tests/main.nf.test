nextflow_process {

    name "Test Process FAMDBPYEMBL"
    script "../main.nf"
    process "FAMDBPYEMBL"

    tag "modules"
    tag "modules_local"
    tag "famdbpyembl"

    // test.0.h5 is synthetic, built by build_test_famdb.py (see that file to regenerate).
    test("famdbpyembl - descendants of test taxon") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    [ file("\${baseDir}/modules/local/famdbpyembl/tests/test.0.h5", checkIfExists: true) ]
                ]
                input[1] = '3'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("famdbpyembl - descendants of test taxon - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    [ file("\${baseDir}/modules/local/famdbpyembl/tests/test.0.h5", checkIfExists: true) ]
                ]
                input[1] = '3'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
