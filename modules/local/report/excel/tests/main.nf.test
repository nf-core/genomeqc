nextflow_process {

    name "Test Process REPORT_EXCEL"
    script "../main.nf"
    process "REPORT_EXCEL"

    tag "modules"
    tag "modules_local"
    tag "report"
    tag "report/excel"

    test("report_excel - no optional inputs") {

        when {
            process {
                """
                input[0] = []
                input[1] = []
                input[2] = []
                input[3] = []
                input[4] = []
                input[5] = []
                input[6] = []
                input[7] = []
                input[8] = []
                input[9] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.excel[0]).exists() },
                { assert snapshot(process.out.versions_python).match() }
            )
        }
    }

    test("report_excel - no optional inputs - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = []
                input[1] = []
                input[2] = []
                input[3] = []
                input[4] = []
                input[5] = []
                input[6] = []
                input[7] = []
                input[8] = []
                input[9] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
