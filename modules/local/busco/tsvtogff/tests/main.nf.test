nextflow_process {

    name "Test Process BUSCO_TSVTOGFF"
    script "../main.nf"
    process "BUSCO_TSVTOGFF"

    tag "modules"
    tag "modules_local"
    tag "busco"
    tag "busco/tsvtogff"

    test("busco_tsvtogff - full_table") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file("\${baseDir}/modules/local/busco/tsvtogff/tests/busco_output", checkIfExists: true)
                ]
                """
            }
        }

        then {
            // Non-deterministic ##date/timestamp fields stripped before snapshotting.
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.gff[0][0],
                    path(process.out.gff[0][1]).readLines().findAll { !it.startsWith('##date') },
                    process.out.stats[0][0],
                    path(process.out.stats[0][1]).json.findAll { k, v -> k != 'timestamp' }
                    ).match() }
            )
        }
    }

    test("busco_tsvtogff - full_table - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file("\${baseDir}/modules/local/busco/tsvtogff/tests/busco_output", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
