nextflow_process {

    name "Test Process TABLE_FCSGX"
    script "../main.nf"
    process "TABLE_FCSGX"

    tag "modules"
    tag "modules_local"
    tag "table"
    tag "table/fcsgx"

    test("table_fcsgx - two reports, one clean") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    [
                        file("\${baseDir}/modules/local/table/fcsgx/tests/speciesA.fcs_gx_report.txt", checkIfExists: true),
                        file("\${baseDir}/modules/local/table/fcsgx/tests/speciesB.fcs_gx_report.txt", checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("table_fcsgx - two reports, one clean - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    [
                        file("\${baseDir}/modules/local/table/fcsgx/tests/speciesA.fcs_gx_report.txt", checkIfExists: true),
                        file("\${baseDir}/modules/local/table/fcsgx/tests/speciesB.fcs_gx_report.txt", checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
