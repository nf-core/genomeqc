/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/genomeqc -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 2,
        memory: '4.GB',
        time: '6.h'
    ]
}

params {
    config_profile_name        = 'Decontamination test profile'
    config_profile_description = 'Minimal test dataset to check pipeline decontamination screening step'

    // Input data
    input  = "${projectDir}/assets/input_decon.csv"

    // Test input for decon is from yeast
    busco_lineage              = 'saccharomycetes_odb10'
    // Test database
    gxdb_manifest              = 'https://ftp.ncbi.nlm.nih.gov/genomes/TOOLS/FCS/database/test-only/test-only.manifest'

    skip_tidk                  = true

}
